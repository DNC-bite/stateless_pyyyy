# Copia este archivo como ".env" y llena tus valores. NUNCA subas ".env" a GitHub.

DEBUG=True
# En producción es obligatoria. Para generar una:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
BASE_URL=http://127.0.0.1:8081

# --- Base de datos ------------------------------------------------------------
# Opción A (recomendada): MySQL en Docker  ->  docker compose up -d   (usa el puerto 3307)
DB_ENGINE=mysql
DB_NAME=stateless_db
DB_USER=stateless
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3307
# Opción B: SQLite, sin instalar nada (solo para probar): DB_ENGINE=sqlite
# OJO: el MariaDB 10.4 de XAMPP NO sirve; Django 5.2 exige MariaDB 10.5 o superior.

# --- Correo (si lo dejas vacío, los correos se imprimen en la terminal) ---------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Solo en desarrollo: a este correo llegan los avisos dirigidos a direcciones de prueba
EMAIL_REDIRECT_TO=

# --- Imágenes (Cloudinary). Claves NUEVAS: las anteriores quedaron expuestas ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google y Spotify (partes siguientes). Claves NUEVAS -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Datos de la factura ---------------------------------------------------------
EMPRESA_NOMBRE=STATELESS CLOTHING S.A.S.
EMPRESA_NIT=901.458.789-1
EMPRESA_CIUDAD=Bogotá D.C., Colombia
EMPRESA_CORREO_SOPORTE=stateless2000@gmail.com

# --- Mercado Pago (Checkout Pro con Preferences API) --------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS de esta aplicación para recibir webhooks; local sirve solo para desarrollo.
MERCADOPAGO_PUBLIC_URL=http://127.0.0.1:8081
